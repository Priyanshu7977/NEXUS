# ==============================================================================
# NEXUS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth Foundation
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key_here

# (Optional fallback compatibility aliases)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key_here

# ------------------------------------------------------------------------------
# 2. Connector Security & Token Encryption
# ------------------------------------------------------------------------------
# 32-character AES-GCM secret key used to encrypt provider OAuth access tokens
VITE_CONNECTOR_ENCRYPTION_KEY=nexus_live_aes256_enc_key_32chars!

# ------------------------------------------------------------------------------
# 3. GitHub Connector (OAuth 2.0 App)
# ------------------------------------------------------------------------------
# Register at: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:5180/app/connectors/callback/github
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 4. GitHub Webhook Ingestion
# ------------------------------------------------------------------------------
# Secret configured in GitHub repository Webhook settings (Payload URL: /api/webhooks/github)
VITE_GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Vercel Connector & Deployment Automation
# ------------------------------------------------------------------------------
# Vercel Personal Access Token generated at: https://vercel.com/account/tokens
VITE_VERCEL_ACCESS_TOKEN=your_vercel_access_token_here
VITE_VERCEL_CLIENT_ID=your_vercel_client_id

# ------------------------------------------------------------------------------
# 6. AI Model Providers (NEXUS Agent Runtime)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=your_openai_api_key_here


